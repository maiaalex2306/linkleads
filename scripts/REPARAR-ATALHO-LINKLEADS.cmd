ct { $_.DisplayName -like 'LinkLeads*' })){if($entry.InstallLocation){$candidates+= (Join-Path $entry.InstallLocation 'LinkLeads.exe')};if($entry.DisplayIcon){$candidates+= (($entry.DisplayIcon -replace ',[0-9]+$','').Trim([char]34))}}};if(-not (Test-Path -LiteralPath $desktop -PathType Container)){ $otherDesktops=@();if($env:USERPROFILE){$otherDesktops+=(Join-Path $env:USERPROFILE 'Desktop')};if($env:OneDrive){$otherDesktops+=(Join-Path $env:OneDrive 'Desktop')};$desktop=@($otherDesktops | Where-Object {Test-Path -LiteralPath $_ -PathType Container} | Select-Object -First 1)[0]};};if(-not $desktop -or -not (Test-Path -LiteralPath $desktop -PathType Container)){throw 'Area de trabalho do usuario nao encontrada'};$expectedVersion='';if(-not $test -and $env:LL_INSTALLER){$match=[regex]::Match([IO.Path]::GetFileName($env:LL_INSTALLER),'LinkLeads-Setup-(\d+\.\d+\.\d+)\.exe$');if($match.Success){$expectedVersion=$match.Groups[1].Value}};$exe=$null;$installedVersion='';foreach($candidate in @($candidates | Select-Object -Unique)){if($candidate -and ([IO.Path]::GetFileName($candidate) -ieq 'LinkLeads.exe') -and (Test-Path -LiteralPath $candidate -PathType Leaf)){$item=Get-Item -LiteralPath $candidate;$version=$item.VersionInfo.ProductVersion;if(-not $expectedVersion -or ($version -and $version.StartsWith($expectedVersion))){$exe=[IO.Path]::GetFullPath($candidate);$installedVersion=$version;break}}};if(-not $exe){throw ('LinkLeads.exe nao encontrado na versao esperada: '+$expectedVersion+'. Instalacao pode estar incompleta ou ter sido cancelada')};$shortcut=Join-Path $desktop 'LinkLeads.lnk';$ok=$false;if(Test-Path -LiteralPath $shortcut -PathType Leaf){try{$current=$shell.CreateShortcut($shortcut).TargetPath;$ok=($current -and ([IO.Path]::GetFullPath($current) -ieq $exe))}catch{}};if(-not $ok){$lnk=$shell.CreateShortcut($shortcut);$lnk.TargetPath=$exe;$lnk.WorkingDirectory=[IO.Path]::GetDirectoryName($exe);$lnk.IconLocation=$exe+',0';$lnk.Description='LinkLeads';$lnk.Save()};if(-not (Test-Path -LiteralPath $shortcut -PathType Leaf)){throw 'Atalho nao gravado'};$check=$shell.CreateShortcut($shortcut).TargetPath;if(([IO.Path]::GetFullPath($check)) -ine $exe){throw 'Atalho aponta para o executavel incorreto'};$state='aprovado';Write-Host ('LINKLEADS INSTALADO: '+$exe) -ForegroundColor Green;Write-Host ('ATALHO CONFIRMADO: '+$shortcut) -ForegroundColor Green;}catch{$reason=$_.Exception.Message;Write-Host ('ERRO: '+$reason) -ForegroundColor Red};try{New-Item -ItemType Directory -Path $reportDir -Force -ErrorAction Stop | Out-Null;[ordered]@{schema='linkleads.shortcut.repair.v1';at=(Get-Date).ToString('o');status=$state;error=$reason;executable=$exe;expectedVersion=$expectedVersion;installedVersion=$installedVersion;desktop=$desktop;shortcut=$shortcut;testMode=$test} | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $reportDir 'resultado-atalho.json') -Encoding UTF8;Write-Host ('Relatorio: '+(Join-Path $reportDir 'resultado-atalho.json'))}catch{Write-Host ('Aviso: nao foi possivel salvar o relatorio: '+$_.Exception.Message) -ForegroundColor Yellow};if($state -ne 'aprovado'){exit 1}"
