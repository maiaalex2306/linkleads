{
  "name": "@linkleads/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/renderer','dist/renderer',{recursive:true})\"",
    "dev": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@linkleads/core": "0.1.0",
    "@linkleads/db": "0.1.0",
    "@linkleads/ai": "0.1.0",
    "@linkleads/integrations": "0.1.0"
  },
  "devDependencies": {
    "electron": "^37.2.0"
  }
}
