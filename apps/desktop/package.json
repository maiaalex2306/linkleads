{
  "name": "@linkleads/desktop",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/renderer','dist/renderer',{recursive:true})\" && node scripts/build-info.cjs",
    "dev": "electron .",
    "dev:build": "npm run build && electron .",
    "pretest": "npm run build:deps --prefix ../..",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "dist": "npm run bundle && electron-builder --publish never",
    "dist:linux": "npm run bundle && electron-builder --linux --publish never",
    "release": "npm run bundle && electron-builder --publish always"
  },
  "dependencies": {
    "@linkleads/ai": "0.1.0",
    "@linkleads/core": "0.1.0",
    "@linkleads/db": "0.1.0",
    "@linkleads/integrations": "0.1.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "42.11.16",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12"
  },
  "author": "LinkLeads"
}
